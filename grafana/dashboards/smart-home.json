{
  "uid": "smart-home",
  "title": "Smart home",
  "tags": [
    "iot"
  ],
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "house",
        "type": "textbox",
        "label": "House",
        "query": "home01",
        "current": {
          "text": "home01",
          "value": "home01"
        }
      },
      {
        "name": "room",
        "type": "query",
        "label": "Room",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": {
          "queryType": "dimensionValues",
          "namespace": "SmartHome",
          "region": "default",
          "metricName": "Temperature",
          "dimensionKey": "Room",
          "dimensionFilters": {
            "House": "$house"
          }
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Temperature",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "SmartHome",
          "metricName": "Temperature",
          "dimensions": {
            "House": "$house",
            "Room": "$room"
          },
          "matchExact": true,
          "statistic": "Average",
          "period": "",
          "label": "${PROP('Dim.Room')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Humidity",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "SmartHome",
          "metricName": "Humidity",
          "dimensions": {
            "House": "$house",
            "Room": "$room"
          },
          "matchExact": true,
          "statistic": "Average",
          "period": "",
          "label": "${PROP('Dim.Room')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Motion",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "SmartHome",
          "metricName": "Motion",
          "dimensions": {
            "House": "$house",
            "Room": "$room"
          },
          "matchExact": true,
          "statistic": "Maximum",
          "period": "",
          "label": "${PROP('Dim.Room')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": null,
                "result": {
                  "text": "Detected",
                  "color": "orange"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": null,
                "to": 0.5,
                "result": {
                  "text": "None",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
